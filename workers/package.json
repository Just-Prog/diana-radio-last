{
  "name": "diana-radio-last-workers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply",
    "db:migrations": "wrangler d1 migrations list",
    "db": "drizzle-kit generate && wrangler d1 migrations apply"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "otpauth": "^9.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.110.0"
  }
}
