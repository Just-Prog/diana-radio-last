{
  "name": "diana-radio-last-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ./frontend --filter ./workers --parallel --stream run dev",
    "dev:web": "pnpm --filter ./frontend run dev",
    "dev:api": "pnpm --filter ./workers run dev",
    "build": "pnpm --filter ./frontend --filter ./workers run build",
    "typecheck": "pnpm --filter ./frontend run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
