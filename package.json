{
  "dependencies": {
    "@solidjs/router": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.4.49",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.3.3",
    "ultracite": "7.12.0",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  },
  "name": "diana-radio-last",
  "scripts": {
    "start": "bun run dev",
    "dev": "bun run --parallel dev:web dev:worker",
    "dev:web": "vite",
    "dev:worker": "bun --cwd=workers run dev",
    "build": "bun run build:web && bun run build:worker",
    "build:web": "vite build",
    "build:worker": "bun --cwd=workers run build",
    "deploy:worker": "bun --cwd=workers run deploy",
    "serve": "vite preview",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "type": "module",
  "version": "0.0.-1",
  "workspaces": [
    "workers"
  ],
  "description": "",
  "private": true,
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "license": "MIT"
}
